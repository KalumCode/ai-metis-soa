<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Metis</AssemblyName>
    <RootNamespace>Metis.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Web 产物：构建前由 build.ps1 从 desktop/dist 拷入 Resources/webdist -->
    <WebDistSource Condition="'$(WebDistSource)' == ''">$(MSBuildProjectDirectory)\Resources\webdist</WebDistSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- 打包 Web 渲染层产物 -->
  <ItemGroup>
    <Content Include="$(WebDistSource)\**\*" CopyToOutputDirectory="PreserveNewest" Link="webdist\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
