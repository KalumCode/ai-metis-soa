<UserControl x:Class="Metis.Desktop.Window.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource TitleBarBackground}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 左侧：应用名（空白区参与拖窗） -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
        <TextBlock Text="Metis" FontSize="12" Foreground="{StaticResource TitleBarForeground}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <!-- 中间空白拖动区 -->
      <Border Grid.Column="1" Background="Transparent" />
      <!-- 右侧窗口控制 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="MinimizeButton" Width="46" Height="34" Background="Transparent"
                BorderThickness="0" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                Foreground="{StaticResource TitleBarForeground}" Click="OnMinimize" />
        <Button x:Name="MaximizeButton" Width="46" Height="34" Background="Transparent"
                BorderThickness="0" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                Foreground="{StaticResource TitleBarForeground}" Click="OnMaximize" />
        <Button x:Name="CloseButton" Width="46" Height="34" Background="Transparent"
                BorderThickness="0" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                Foreground="{StaticResource TitleBarForeground}" Click="OnClose" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
